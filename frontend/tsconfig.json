{
  "compilerOptions": {
    "target": "ES2024",
    "useDefineForClassFields": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],

    "allowJs": false,
    "skipLibCheck": true,

    "module": "ESNext",
    "moduleResolution": "Bundler",

    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    "jsx": "react-jsx",

    "strict": true,

    "paths": {
      "@/*": ["./src/*"]
    }
  },

  "include": ["src"],

  "exclude": ["node_modules", "dist"]
}